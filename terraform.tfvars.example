# ==============================================================================
# Exemple de configuration des variables pour la Phase 1
# Copiez ce fichier vers 'terraform.tfvars' et renseignez vos valeurs réelles.
# ==============================================================================

aws_region  = "us-east-1"
environment = "prod"

# Nom du cluster EKS (laisser 'realestate-prod-cluster' pour correspondre au manifest ALB)
cluster_name = "realestate-prod-cluster"

# Votre adresse IP publique avec le masque /32
# Astuce : obtenez votre IP publique en tapant : curl -s ifconfig.me
my_ip_address = "82.64.12.34/32"

# Identifiants de la base de données MySQL
db_name     = "product_intelligence"
db_username = "appuser"
db_password = "ChangeMeSuperSecurePassword2026!"

# Type d'instance 
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20

